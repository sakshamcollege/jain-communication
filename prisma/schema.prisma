// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("STAFF") // ADMIN or STAFF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  recharges Recharge[]
}

// Product model for inventory management
model Product {
  id             String          @id @default(uuid())
  name           String
  category       String
  purchasePrice  Float
  sellingPrice   Float
  stock          Int             @default(0)
  imei           String?
  supplier       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sales          Sale[]
  stockMovements StockMovement[]
}

// Sale model for recording transactions
model Sale {
  id            String   @id @default(uuid())
  productId     String
  userId        String?
  quantity      Int
  sellingPrice  Float
  purchasePrice Float
  profit        Float
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([productId])
}

// Recharge model for recording total daily mobile recharges
model Recharge {
  id          String   @id @default(uuid())
  amount      Float    // Total recharge amount
  profit      Float    // Auto-calculated at 3% commission
  description String?  // Optional description
  userId      String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// Stock Movement model for tracking stock history
model StockMovement {
  id            String   @id @default(uuid())
  productId     String
  type          String   // "STOCK_IN" | "STOCK_OUT" | "INITIAL" | "ADJUSTMENT"
  quantity      Int      // Positive for stock in, negative for stock out
  previousStock Int      // Stock before this movement
  newStock      Int      // Stock after this movement
  reason        String?  // Optional reason/description
  referenceId   String?  // Reference to sale ID if it's a sale
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([productId])
  @@index([type])
}
