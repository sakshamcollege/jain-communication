// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartyType {
  CUSTOMER
  VENDOR
}

enum CreditTransactionType {
  CHARGE
  PAYMENT
}

enum CreditSourceType {
  RECHARGE
  EXPENSE
  MANUAL
}

// User model for authentication
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("BUYER") // DEVELOPER, OWNER, BUYER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  recharges Recharge[]
}

// Product model for inventory management
model Product {
  id             String          @id @default(uuid())
  name           String
  category       String
  purchasePrice  Float
  sellingPrice   Float
  stock          Int             @default(0)
  imei           String?
  supplier       String?
  // New fields for Shopping Page / Smart Entry
  description    String?         @db.Text
  specs          String?         @db.Text
  frontImage     String?
  backImage      String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sales          Sale[]
  stockMovements StockMovement[]
}

// Sale model for recording transactions
model Sale {
  id            String   @id @default(uuid())
  productId     String
  userId        String?
  quantity      Int
  sellingPrice  Float
  purchasePrice Float
  profit        Float
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([productId])
}

// Recharge model for recording total daily mobile recharges
model Recharge {
  id          String   @id @default(uuid())
  amount      Float    // Total recharge amount
  profit      Float    // Auto-calculated at 3% commission
  description String?  // Optional description
  userId      String?
  isCredit    Boolean  @default(false)
  partyId     String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  party Party? @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([isCredit])
  @@index([partyId])
}

// Stock Movement model for tracking stock history
model StockMovement {
  id            String   @id @default(uuid())
  productId     String
  type          String   // "STOCK_IN" | "STOCK_OUT" | "INITIAL" | "ADJUSTMENT"
  quantity      Int      // Positive for stock in, negative for stock out
  previousStock Int      // Stock before this movement
  newStock      Int      // Stock after this movement
  reason        String?  // Optional reason/description
  referenceId   String?  // Reference to sale ID if it's a sale
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([productId])
  @@index([type])
}

// Expense model for tracking daily expenses
model Expense {
  id          String   @id @default(uuid())
  amount      Float    // Expense amount
  paymentMode String   // Payment mode (SBI Card, HDFC Card, etc.)
  description String   // What the expense was made for
  isCredit    Boolean  @default(false)
  partyId     String?
  createdAt   DateTime @default(now())

  party Party? @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([paymentMode])
  @@index([isCredit])
  @@index([partyId])
}

model Party {
  id             String            @id @default(uuid())
  type           PartyType
  name           String
  normalizedName String
  phone          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  transactions CreditTransaction[]
  recharges    Recharge[]
  expenses     Expense[]

  @@unique([type, normalizedName])
  @@index([type])
  @@index([name])
}

model CreditTransaction {
  id        String                @id @default(uuid())
  partyId   String
  type      CreditTransactionType
  source    CreditSourceType
  sourceId  String?
  amount    Float
  note      String?
  createdAt DateTime              @default(now())

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, createdAt])
  @@index([source, sourceId])
  @@unique([source, sourceId, type])
}
